{
  "name": "gpt-switch-desktop",
  "version": "3.0.1",
  "description": "GPT Switch desktop client",
  "license": "MIT",
  "author": "GPT Switch",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.main.json && node scripts/generate-build-config.mjs && tsc -p tsconfig.renderer.json && vite build",
    "dev": "node scripts/dev.mjs",
    "electron:dev": "node scripts/dev.mjs",
    "build:win": "pnpm build && electron-builder --win nsis --x64",
    "build:win:portable": "pnpm build && electron-builder --win portable --x64",
    "build:mac": "pnpm build && electron-builder --mac dmg --arm64 -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.eting.ai-model-v2",
    "productName": "GPT Switch",
    "icon": "build/icon",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "zh_CN"
    ]
  },
  "devDependencies": {
    "@ant-design/icons": "5.6.1",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "antd": "5.29.3",
    "electron": "35.7.5",
    "electron-builder": "25.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
